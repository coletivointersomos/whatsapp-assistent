LIVE_SEND=false
HMAC_REQUIRED=true
PORT=8791
SERVICE_NAME=hermes-arnaldo-transportadora

# Número/sessão OpenWA (não hardcode no core). Trocar depois = só este valor.
SESSION_ID=sessao-lab-substituivel

# JID do único grupo autorizado a RECEBER resposta real neste teste.
TEST_GROUP_JID=grupo-lab-teste@g.us

# Allowlist (JIDs). Pode ter mais chats para processar; envio real só vai ao TEST_GROUP_JID.
ALLOWED_JIDS=grupo-lab-teste@g.us
ADMIN_IDS=alana-lab@c.us
BOT_IDS=bot-lab@c.us
# JIDs do motorista principal no TEST_GROUP_JID (participante, não o id do grupo).
DRIVER_JIDS=chat-motorista-1@c.us
# CENTRAL_JID=

CHANNEL_FILE=config/channel.example.json
STORE_PATH=data/store.json

# OpenWA (lab: http://openwa-api:2785). Não commitar token.
OPENWA_BASE_URL=http://openwa-api:2785
OPENWA_API_KEY=
OPENWA_API_KEY_HEADER=X-Api-Key
OPENWA_SEND_PATH=/api/sessions/{sessionId}/messages/text

# Segredo HMAC do webhook e do POST /resume (`x-resume-secret` ou assinatura HMAC do body).
# Nunca commitar o valor real.
OPENWA_HMAC_SECRET=

# Assistant V2 (chat livre + registro operacional). Produção do grupo usa true.
ASSISTANT_V2_ENABLED=false
ASSISTANT_V2_SESSION_STARTED_AT=

# Planilha — experimento da quinta via Apps Script (sem service account).
# Cole apps-script/registros-sync.gs na planilha, publique como app da Web, URL /exec + o mesmo token.
# SHEETS_SYNC_ENABLED=true só grava se URL e token existirem (ou se houver service account).
SHEETS_SYNC_ENABLED=false
SHEETS_APPS_SCRIPT_URL=
SHEETS_APPS_SCRIPT_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=
DRIVE_FOLDER_ID=
SHEETS_SPREADSHEET_ID=
SHEETS_TAB_NAME=registros

# NLU/LLM (interpretador JSON). Só chama rede se ENABLED=true, PROVIDER=llm, key e base URL.
LLM_NLU_ENABLED=false
LLM_NLU_PROVIDER=fake
LLM_NLU_MODEL=
LLM_NLU_API_KEY=
LLM_NLU_BASE_URL=
LLM_NLU_TIMEOUT_MS=8000
LLM_NLU_MAX_TOKENS=512
# false se o provedor rejeitar response_format json_object
LLM_NLU_JSON_OBJECT=true
