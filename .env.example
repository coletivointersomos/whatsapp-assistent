LIVE_SEND=false
HMAC_REQUIRED=true
PORT=8791
SERVICE_NAME=hermes-arnaldo-transportadora

# Número/sessão OpenWA (não hardcode no core). Trocar depois = só este valor.
SESSION_ID=sessao-lab-substituivel

# JID do único grupo autorizado a RECEBER resposta real neste teste.
TEST_GROUP_JID=grupo-lab-teste@g.us

# Allowlist (JIDs). Pode ter mais chats para processar; envio real só vai ao TEST_GROUP_JID.
ALLOWED_JIDS=grupo-lab-teste@g.us
ADMIN_IDS=alana-lab@c.us
BOT_IDS=bot-lab@c.us
# JIDs do motorista principal no TEST_GROUP_JID (participante, não o id do grupo).
DRIVER_JIDS=chat-motorista-1@c.us
# CENTRAL_JID=

CHANNEL_FILE=config/channel.example.json
STORE_PATH=data/store.json

# OpenWA (lab: http://openwa-api:2785). Não commitar token.
OPENWA_BASE_URL=http://openwa-api:2785
OPENWA_API_KEY=
OPENWA_API_KEY_HEADER=X-Api-Key
OPENWA_SEND_PATH=/api/sessions/{sessionId}/messages/text

# Segredo HMAC do webhook e do POST /resume (`x-resume-secret` ou assinatura HMAC do body).
# Nunca commitar o valor real.
OPENWA_HMAC_SECRET=
